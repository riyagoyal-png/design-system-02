{
  "name": "vision-automation-design-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vision Automation design system and interactive showcase, reconstructed from the DEOC Figma screens (spec/DESIGN_SYSTEM.md).",
  "scripts": {
    "spec": "node scripts/extract-spec.mjs",
    "dev": "npm run spec && vite",
    "build": "npm run spec && tsc --noEmit && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:interactions": "node scripts/check-interactions.mjs",
    "check:deoc": "node scripts/check-deoc.mjs",
    "qa": "npm run build && npm run check:tokens && npm run check:browser && npm run check:interactions"
  },
  "dependencies": {
    "d3-chord": "^3.0.1",
    "d3-contour": "^4.0.2",
    "d3-hexbin": "^0.2.2",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/d3-chord": "^3.0.6",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-hexbin": "^0.2.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "playwright-core": "1.49",
    "postcss": "^8.5.29",
    "typescript": "5.7",
    "vite": "^6.4.4"
  }
}
